{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": ["Process terraform files"],
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-provider"],
      "versioning": "terraform",
      "matchPackagePatterns": [".*"]
    },
    {
      "description": "Bambuddy uses 4-segment versions (0.2.4.2) — needs loose versioning; skip beta tags",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/maziggy/bambuddy"],
      "versioning": "loose",
      "ignoreUnstable": true,
      "allowedVersions": "!/b\\d+$/"
    },
    {
      "description": "Mautrix bridges: pin to v0.YYMM.X scheme (CalVer alias tags vYY.MM.X order INCORRECTLY under semver and would cause downgrades, e.g. v26.02.2 < v0.2605.0 by date but > by semver)",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "dock.mau.dev/mautrix/signal",
        "dock.mau.dev/mautrix/meta",
        "dock.mau.dev/mautrix/discord",
        "dock.mau.dev/mautrix/whatsapp",
        "dock.mau.dev/mautrix/telegram"
      ],
      "allowedVersions": "/^v0\\.\\d+\\.\\d+$/"
    },
    {
      "description": "Envoy proxy uses distroless-prefixed tags (distroless-v1.38.2); strip prefix so Renovate can semver-compare and resume update PRs",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mirror.gcr.io/envoyproxy/envoy"],
      "extractVersion": "^distroless-(?<version>.+)$"
    },
    {
      // siderolabs pushes the git tag before publishing the release, and mise
      // pulls talosctl from the release assets -- so a tag-only version 404s and
      // breaks Setup Mise in every workflow. Wait for the assets to exist.
      "description": "Let Talos releases settle before bumping talosctl",
      "matchPackageNames": ["/talosctl/", "/siderolabs/talos/"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Ceph encodes stability in the minor: x.0.z is dev, x.1.z is a release candidate, only x.2.z is stable. Semver reads v21.1.1 as newer than v19.2.6 and kept opening PRs for an RC",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/ceph/ceph"],
      "allowedVersions": "/^v\\d+\\.2\\.\\d+$/"
    }
  ]
}
