{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Changelog URL for gatus-sidecar",
      matchPackageNames: ["/gatus-sidecar/"],
      changelogUrl: "https://github.com/home-operations/gatus-sidecar/blob/main/CHANGELOG.md",
    },
    {
      description: "Changelog URL for actions-runner-controller",
      matchPackageNames: ["/gha-runner-scale-set/"],
      changelogUrl: "https://github.com/actions/actions-runner-controller",
    },
    {
      description: "Changelog URL for dragonfly-operator",
      matchPackageNames: ["/dragonfly-operator/"],
      changelogUrl: "https://github.com/dragonflydb/dragonfly-operator",
    },
    {
      description: "Changelog URL for tofu-controller",
      matchPackageNames: ["/tofu-controller/"],
      changelogUrl: "https://github.com/flux-iac/tofu-controller",
    },
    {
      description: "Changelog URL for grafana-operator",
      matchPackageNames: ["/grafana-operator/"],
      changelogUrl: "https://github.com/grafana/grafana-operator",
    },
    {
      description: "Changelog URL for Spegel",
      matchPackageNames: ["/spegel/"],
      changelogUrl: "https://github.com/spegel-org/spegel",
    },
    {
      description: "Changelog URL for code-server",
      matchPackageNames: ["/code-server/"],
      changelogUrl: "https://github.com/coder/code-server",
    },
    {
      description: "Changelog URL for kubernetes-mcp-server",
      matchPackageNames: ["/kubernetes-mcp-server/"],
      changelogUrl: "https://github.com/containers/kubernetes-mcp-server",
    },
    {
      description: "Changelog URL for Authentik",
      matchPackageNames: ["/goauthentik/"],
      changelogUrl: "https://github.com/goauthentik/authentik",
    },
    {
      description: "Changelog URL for Bambuddy",
      matchPackageNames: ["/bambuddy/"],
      changelogUrl: "https://github.com/maziggy/bambuddy",
    },
    {
      description: "Changelog URL for Anubis",
      matchPackageNames: ["/techarohq/anubis/"],
      changelogUrl: "https://github.com/TecharoHQ/anubis",
    },
    {
      // K8s-ready fork; versions map 1:1 to upstream forgejo-runner
      description: "Changelog URL for Forgejo runner (eleboucher fork)",
      matchPackageNames: ["/eleboucher/runner$/"],
      changelogUrl: "https://code.forgejo.org/forgejo/runner",
    },
    {
      description: "Changelog URL for Forgejo runner-k8s-plugin",
      matchPackageNames: ["/eleboucher/runner-k8s-plugin/"],
      changelogUrl: "https://git.erwanleboucher.dev/eleboucher/runner-k8s-plugin",
    },
    {
      // factory.talos.dev + ghcr.io/siderolabs/installer resolve to no changelog
      description: "Changelog URL for Talos Linux",
      matchPackageNames: ["/siderolabs/installer/", "/metal-installer/"],
      changelogUrl: "https://github.com/siderolabs/talos",
    },
    {
      description: "Changelog URL for Towonel (codeberg)",
      matchPackageNames: ["/towonel/"],
      changelogUrl: "https://codeberg.org/towonel/towonel",
    },
    {
      // iroh-relay is a crate in the iroh monorepo
      description: "Changelog URL for iroh-relay",
      matchPackageNames: ["/iroh-relay/"],
      changelogUrl: "https://github.com/n0-computer/iroh",
    },
    {
      // data-plane Envoy image ($ anchor avoids matching envoyproxy/gateway-helm)
      description: "Changelog URL for Envoy proxy",
      matchPackageNames: ["/envoyproxy/envoy$/"],
      changelogUrl: "https://github.com/envoyproxy/envoy",
    },
    // Our registry.vzkn.eu/containers/* images (built in ~/git/containers) point at
    // the upstream tool each packages, per their image.source labels.
    {
      description: "Changelog URL for flux-operator-mcp",
      matchPackageNames: ["/containers/flux-operator-mcp/"],
      changelogUrl: "https://github.com/controlplaneio-fluxcd/flux-operator",
    },
    {
      description: "Changelog URL for sentry-mcp",
      matchPackageNames: ["/containers/sentry-mcp/"],
      changelogUrl: "https://github.com/getsentry/sentry-mcp",
    },
    {
      description: "Changelog URL for mcp-nixos",
      matchPackageNames: ["/containers/mcp-nixos/"],
      changelogUrl: "https://github.com/utensils/mcp-nixos",
    },
    {
      description: "Changelog URL for talos-mcp",
      matchPackageNames: ["/containers/talos-mcp/"],
      changelogUrl: "https://github.com/eleboucher/talos-mcp",
    },
    {
      description: "Changelog URL for agentmemory",
      matchPackageNames: ["/containers/agentmemory/"],
      changelogUrl: "https://github.com/rohitg00/agentmemory",
    },
  ],
}
