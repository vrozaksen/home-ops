---
# Base machine config, rendered by scripts/render-machine-config.sh with
# `--define machinetype=<controlplane|worker>` and Infisical supplying the
# secrets. Derived from talhelper's own output for a patch-free cluster, so it
# holds only what is common to every node.
#
# Deliberately absent, because later layers own it:
#   machine.install, hostname, network  -> talos/nodes/<role>/<node>.yaml.j2
#   everything else                     -> talos/patches/{global,controller}/
#
# Workers get empty CA keys and no etcd section; that mirrors what talhelper
# emits and is not an oversight.
version: v1alpha1
debug: false
persist: true
machine:
  type: {{ machinetype }}
  token: {{ ENV['MACHINE_TOKEN'] }}
  ca:
    crt: {{ ENV['MACHINE_CA_CRT'] }}
{% if machinetype == 'controlplane' %}
    key: {{ ENV['MACHINE_CA_KEY'] }}
{% else %}
    key: ""
{% endif %}
  certSANs: []
  kubelet:
    # renovate: datasource=docker depName=ghcr.io/siderolabs/kubelet
    image: ghcr.io/siderolabs/kubelet:v1.36.4
    defaultRuntimeSeccompProfileEnabled: true
    disableManifestsDirectory: true
  features:
    diskQuotaSupport: true
    kubePrism:
      enabled: true
      port: 7445
    hostDNS:
      enabled: true
      forwardKubeDNSToHost: true
cluster:
  id: {{ ENV['CLUSTER_ID'] }}
  secret: {{ ENV['CLUSTER_SECRET'] }}
  controlPlane:
    endpoint: https://10.10.0.20:6443
  clusterName: main
  network:
    cni:
      name: none
    dnsDomain: cluster.local
    podSubnets:
      - 10.69.0.0/16
    serviceSubnets:
      - 10.96.0.0/16
  token: {{ ENV['CLUSTER_TOKEN'] }}
  ca:
    crt: {{ ENV['CLUSTER_CA_CRT'] }}
{% if machinetype == 'controlplane' %}
    key: {{ ENV['CLUSTER_CA_KEY'] }}
{% else %}
    key: ""
{% endif %}
{% if machinetype == 'controlplane' %}
  secretboxEncryptionSecret: {{ ENV['CLUSTER_SECRETBOXENCRYPTIONSECRET'] }}
  aggregatorCA:
    crt: {{ ENV['CLUSTER_AGGREGATORCA_CRT'] }}
    key: {{ ENV['CLUSTER_AGGREGATORCA_KEY'] }}
  serviceAccount:
    key: {{ ENV['CLUSTER_SERVICEACCOUNT_KEY'] }}
{% endif %}
  discovery:
    enabled: true
    registries:
      kubernetes:
        disabled: true
      service: {}
{% if machinetype == 'controlplane' %}
  etcd:
    ca:
      crt: {{ ENV['CLUSTER_ETCD_CA_CRT'] }}
      key: {{ ENV['CLUSTER_ETCD_CA_KEY'] }}
{% endif %}
