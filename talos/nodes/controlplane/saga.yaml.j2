# Node patch for saga, layered onto machineconfig.yaml.j2 by
# scripts/render-machine-config.sh. Derived from talhelper's own output so
# the native path emits the same documents it does today.
machine:
  type: controlplane
  install:
    diskSelector:
      model: '*'
    # renovate: datasource=docker depName=ghcr.io/siderolabs/installer
    image: factory.talos.dev/installer-secureboot/56d936e2c7919954cf5e13b2b9c06859ac5475ded8b9878bc63dc0e4bebbf854:v1.13.10
    wipe: false
    grubUseUKICmdline: true
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: "off"
hostname: saga
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: ethSel0
selector:
  match: glob("e0:51:d8:1f:43:3d", mac(link.hardware_addr))
---
apiVersion: v1alpha1
kind: LinkConfig
name: ethSel0
mtu: 1500
addresses:
  - address: 10.10.0.15/24
routes:
  - gateway: 10.10.0.1
