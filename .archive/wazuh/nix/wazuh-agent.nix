{ config, pkgs, ... }:
let
  agentName = "ragnarok";
  # LoadBalancer IP of the in-cluster manager. Reachable from this VLAN via the
  # router, which holds the BGP route for the pool.
  managerAddress = "10.10.0.93";

  # Wazuh has no nixpkgs package (NixOS/nixpkgs#230623 is still open), so the
  # upstream image runs under podman. Keep this in step with the manager --
  # agents newer than their manager are unsupported.
  # renovate: datasource=docker depName=wazuh/wazuh-agent
  imageTag = "4.14.8";

  ossecConf = pkgs.writeText "ossec.conf" ''
    <!--
      Wazuh agent - ragnarok. Generated by modules/services/wazuh-agent.nix;
      edit that, not this file.
    -->
    <ossec_config>
      <client>
        <server>
          <address>${managerAddress}</address>
          <port>1514</port>
          <protocol>tcp</protocol>
        </server>
        <!-- The manager drops an agent to "disconnected" after 20s of silence. -->
        <notify_time>10</notify_time>
        <time-reconnect>60</time-reconnect>
        <auto_restart>yes</auto_restart>
        <crypto_method>aes</crypto_method>
        <enrollment>
          <enabled>yes</enabled>
          <manager_address>${managerAddress}</manager_address>
          <port>1515</port>
          <agent_name>${agentName}</agent_name>
        </enrollment>
      </client>

      <client_buffer>
        <disabled>no</disabled>
        <queue_size>5000</queue_size>
        <events_per_second>500</events_per_second>
      </client_buffer>

      <!-- Host paths are bind-mounted at their real locations so alerts name a
            path that exists on the host. /nix/store is immutable and /etc is
            symlinks into it that change on every rebuild, so neither is watched. -->
      <syscheck>
        <disabled>no</disabled>
        <frequency>43200</frequency>
        <scan_on_start>yes</scan_on_start>
        <alert_new_files>yes</alert_new_files>
        <process_priority>19</process_priority>
        <max_eps>50</max_eps>

        <directories check_all="yes" realtime="yes">/etc/nixos</directories>
        <directories check_all="yes" realtime="yes">/home/vrozaksen/.ssh</directories>

        <skip_nfs>yes</skip_nfs>
        <skip_dev>yes</skip_dev>
        <skip_proc>yes</skip_proc>
        <skip_sys>yes</skip_sys>
      </syscheck>

      <!-- Off: both need the host PID namespace, and sharing it lets the image's
            s6 shutdown signal every process on the host. That is not theoretical
            -- it repeatedly killed the NAS running this same image. -->
      <rootcheck>
        <disabled>yes</disabled>
      </rootcheck>
      <wodle name="syscollector">
        <disabled>yes</disabled>
      </wodle>

      <!-- The real value on this host: sudo failures, SSH logins, unit failures
            and kernel events, matched against Wazuh's own rule set. -->
      <localfile>
        <log_format>journald</log_format>
        <location>journald</location>
      </localfile>

      <logging>
        <log_format>plain</log_format>
      </logging>
    </ossec_config>
  '';
in
{
  # Endpoint telemetry for the workstation, feeding the same manager as the
  # rest of the estate; its alerts reach Pushover through VictoriaLogs and
  # vmalert. Enrolment password lives in secrets/personal.yaml.
  sops.secrets."wazuh-authd-pass" = {
    sopsFile = ../../secrets/personal.yaml;
    key = "wazuh-authd-pass";
    restartUnits = [ "podman-wazuh-agent.service" ];
  };

  # Passed as an environment variable, not a mounted file: the agent drops from
  # root to its own `wazuh` user before reading the password, so a root-only
  # secret is unreadable to it and a readable one would expose the password to
  # every local process. The image's init writes it to authd.pass itself, owned
  # root:wazuh and mode 640. systemd reads this file as root.
  sops.templates."wazuh-agent.env" = {
    content = ''
      WAZUH_REGISTRATION_PASSWORD=${config.sops.placeholder."wazuh-authd-pass"}
    '';
    restartUnits = [ "podman-wazuh-agent.service" ];
  };

  virtualisation.oci-containers = {
    backend = "podman";
    containers.wazuh-agent = {
      image = "wazuh/wazuh-agent:${imageTag}";
      autoStart = true;

      environmentFiles = [ config.sops.templates."wazuh-agent.env".path ];

      volumes = [
        "${ossecConf}:/wazuh-config-mount/etc/ossec.conf:ro"

        # Named volumes, not bind mounts: podman seeds them from the image on
        # first use, which a bind mount would instead hide. client.keys lives
        # here, so losing it means re-enrolling.
        "wazuh-agent-etc:/var/ossec/etc"
        "wazuh-agent-queue:/var/ossec/queue"

        # journald reads the host's journal; without machine-id it would only
        # find the container's own, which is empty.
        "/var/log/journal:/var/log/journal:ro"
        "/etc/machine-id:/etc/machine-id:ro"

        # Watched by FIM. Read-only: the agent observes, never edits.
        "/etc/nixos:/etc/nixos:ro"
        "/home/vrozaksen/.ssh:/home/vrozaksen/.ssh:ro"
      ];

      # Deliberately no --pid=host. FIM hashing is CPU and I/O heavy, and this
      # is a workstation -- the agent must never be able to starve it.
      extraOptions = [
        "--memory=512m"
        "--memory-swap=512m"
        "--cpus=1.0"
        "--pids-limit=200"

        # The observed failure was a live process holding a dead socket: the
        # agent stayed "running" for hours while the manager counted it as
        # disconnected, and nothing recovered it. So this checks for an
        # established connection to the manager rather than for the daemon --
        # 05EA is port 1514 and 01 is ESTABLISHED in /proc/net/tcp.
        "--health-cmd=awk 'NR>1 && $3 ~ /:05EA$/ && $4==\"01\" {f=1} END {exit !f}' /proc/net/tcp"
        "--health-interval=60s"
        "--health-retries=5"
        "--health-start-period=120s"
        "--health-on-failure=restart"
      ];
    };
  };
}
